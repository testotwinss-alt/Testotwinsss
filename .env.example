# Optionale Overrides für die 3 Stripe-Payment-Links (Essentials/Advanced/Premium).
# Die aktiven Links stehen in src/config.js. Diese Variablen überschreiben sie nur,
# wenn gesetzt. Format je Link: https://buy.stripe.com/XXXXXXXX
# WICHTIG: leer lassen, solange kein echter Link existiert — dann scrollt der CTA
# des Pakets sicher zur Paket-Auswahl (#checkout), statt eine tote Stripe-Seite zu öffnen.
VITE_STRIPE_LINK_PAKET1=
VITE_STRIPE_LINK_PAKET2=
VITE_STRIPE_LINK_PAKET3=
