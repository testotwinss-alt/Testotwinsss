# Kopiere diese Datei zu ".env" und trage deinen echten Stripe-Payment-Link ein.
# Format: https://buy.stripe.com/XXXXXXXX (Anleitung: siehe Kommentar in src/config.js).
# WICHTIG: Wert leer lassen, solange kein echter Link existiert — dann scrollen alle
# Kauf-CTAs sicher zur Preis-Box (#checkout), statt eine tote Stripe-Seite zu öffnen.
VITE_STRIPE_PAYMENT_LINK=
